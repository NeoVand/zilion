{
	"name": "@neovand/zilion",
	"version": "0.3.0-dev",
	"publishConfig": {
		"access": "public"
	},
	"description": "A multi-ISA WebGPU batch emulator for Z80, NMOS 6502 and coherent-fetch 8086, with a shared world contract for parallel execution, artificial life and genetic programming.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./z80": {
			"types": "./dist/cores/z80/index.d.ts",
			"import": "./dist/cores/z80/index.js"
		},
		"./m6502": {
			"types": "./dist/cores/m6502/index.d.ts",
			"import": "./dist/cores/m6502/index.js"
		},
		"./i8086": {
			"types": "./dist/cores/i8086/index.d.ts",
			"import": "./dist/cores/i8086/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/cores/bff",
		"README.md",
		"LICENSE",
		"CITATION.cff",
		"THIRD_PARTY.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"prepublishOnly": "npm run build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"check:bytes": "npm run build && node scripts/check-byte-identity.mjs",
		"test:unit": "npm run build && node test/unit.mjs",
		"test:world": "npm run build && node test/world/run.mjs",
		"test:algocell": "npm run build && node test/world/algocell.mjs",
		"test:bff": "npm run build && ${ZILION_PYTHON:-python3} -I test/world/bff_equiv.py --pairs 131072 --cpu 0.0625",
		"test:compat": "npm run build && node test/world/compat02.mjs",
		"test:export": "npm run build && node test/export-machines.mjs",
		"test": "npm run build && node test/unit.mjs && node test/engine-mock.mjs && node test/export-machines.mjs && node scripts/check-byte-identity.mjs && node test/world/run.mjs && node test/world/compat02.mjs",
		"export": "node scripts/export-machines.mjs",
		"test:engine": "npm run build && node test/engine-mock.mjs",
		"test:conformance": "${ZILION_PYTHON:-python3} -I tools/zt.py conformance",
		"test:harness": "${ZILION_PYTHON:-python3} -I -m unittest discover -s test/harness && ${ZILION_PYTHON:-python3} -I tools/zt.py selftest --vectors ${ZILION_Z80_VECTORS:-../zilion-vectors/z80} --vectors-6502 ${ZILION_6502_VECTORS:-../zilion-vectors/6502} --vectors-8086 ${ZILION_8086_VECTORS:-../zilion-vectors/8088}",
		"test:vectors": "${ZILION_PYTHON:-python3} -I tools/zt.py vectors z80 ${ZILION_Z80_VECTORS:-../zilion-vectors/z80} test/vectors/z80/analytic test/vectors/z80/analytic/probes",
		"test:vectors:nmos": "${ZILION_PYTHON:-python3} -I tools/zt.py vectors z80 ${ZILION_Z80_VECTORS:-../zilion-vectors/z80} test/vectors/z80/analytic test/vectors/z80/analytic/probes --variant zilog-nmos",
		"test:vectors:0.2": "${ZILION_PYTHON:-python3} -I tools/zt.py vectors z80 ${ZILION_Z80_VECTORS:-../zilion-vectors/z80} test/vectors/z80/analytic --compat 0.2",
		"test:vectors:6502": "${ZILION_PYTHON:-python3} -I tools/zt.py vectors 6502 ${ZILION_6502_VECTORS:-../zilion-vectors/6502}",
		"test:vectors:8086": "${ZILION_PYTHON:-python3} -I tools/zt.py vectors 8086 ${ZILION_8086_VECTORS:-../zilion-vectors/8088}/v2 ${ZILION_8086_VECTORS:-../zilion-vectors/8088}/v2_undefined --mem-cap 768 --lanes 1024 --workers 1",
		"test:harness:offline": "${ZILION_PYTHON:-python3} -I -m unittest discover -s test/harness && ${ZILION_PYTHON:-python3} -I tools/zt.py selftest"
	},
	"keywords": [
		"z80",
		"6502",
		"nmos-6502",
		"8086",
		"8088",
		"bff",
		"multi-isa",
		"cpu",
		"emulator",
		"webgpu",
		"gpu",
		"gpgpu",
		"wgsl",
		"parallel",
		"batch",
		"artificial-life",
		"alife",
		"genetic-programming",
		"assembly"
	],
	"author": "Mostafa 'Neo' Mohsenvand",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NeoVand/zilion.git"
	},
	"homepage": "https://github.com/NeoVand/zilion#readme",
	"bugs": {
		"url": "https://github.com/NeoVand/zilion/issues"
	},
	"devDependencies": {
		"@webgpu/types": "^0.1.60",
		"typescript": "^5.6.0"
	},
	"sideEffects": false
}
