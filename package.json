{
	"name": "@neovand/zilion",
	"version": "0.3.0-dev",
	"publishConfig": {
		"access": "public"
	},
	"description": "A zillion Z80s in parallel on your GPU \u2014 a WebGPU-accelerated, differentially-tested Z80 CPU emulator for batch execution, artificial life, and genetic programming.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./z80": {
			"types": "./dist/cores/z80/index.d.ts",
			"import": "./dist/cores/z80/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/cores/m6502",
		"!dist/cores/bff",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"prepublishOnly": "npm run build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"check:bytes": "npm run build && node scripts/check-byte-identity.mjs",
		"test:unit": "npm run build && node test/unit.mjs",
		"test:world": "npm run build && node test/world/run.mjs",
		"test:algocell": "npm run build && node test/world/algocell.mjs",
		"test": "npm run build && node test/unit.mjs && node scripts/check-byte-identity.mjs && node test/world/run.mjs",
		"export": "node scripts/export-machines.mjs"
	},
	"keywords": [
		"z80",
		"zilog",
		"cpu",
		"emulator",
		"webgpu",
		"gpu",
		"gpgpu",
		"wgsl",
		"parallel",
		"artificial-life",
		"alife",
		"genetic-programming",
		"assembly",
		"8-bit",
		"retro"
	],
	"author": "NeoVand",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NeoVand/zilion.git"
	},
	"homepage": "https://github.com/NeoVand/zilion#readme",
	"bugs": {
		"url": "https://github.com/NeoVand/zilion/issues"
	},
	"devDependencies": {
		"@webgpu/types": "^0.1.60",
		"typescript": "^5.6.0"
	},
	"sideEffects": false
}
